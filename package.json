{
  "name": "dlbot-mini-app",
  "private": true,
  "version": "1.0.0",
  "description": "Telegram Mini App (Vue 3 + Vite + Tailwind) for the dlbot media downloader.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "sign-init-data": "node scripts/sign-init-data.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
