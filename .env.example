# Public URL of the dlbot web service on Render (no trailing slash). Required.
VITE_API_BASE_URL=https://<dlbot>.onrender.com

# Bot username without @. Optional: powers the "Open in Telegram" button outside Telegram.
VITE_BOT_USERNAME=

# Dev only (`npm run dev` in a normal browser). A signed initData string for your DEV bot,
# generated with `BOT_TOKEN=... npm run sign-init-data`. Ignored in production builds.
VITE_DEV_INIT_DATA=
